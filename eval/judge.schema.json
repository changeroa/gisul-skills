{
  "type": "object",
  "additionalProperties": false,
  "required": ["caseId", "checks"],
  "properties": {
    "caseId": { "type": "string" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "verdict", "reason", "evidence"],
        "properties": {
          "name": { "type": "string" },
          "verdict": { "type": "string", "enum": ["pass", "fail", "abstain"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "quote"],
              "properties": {
                "path": { "type": "string" },
                "quote": { "type": "string", "maxLength": 2000 }
              }
            }
          }
        }
      }
    }
  }
}
