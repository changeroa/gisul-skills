{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project runtime readiness",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "env", "checked_at", "services", "accounts", "contracts", "unmet"],
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "env": { "enum": ["dev", "test"] },
    "checked_at": { "type": "string", "format": "date-time" },
    "services": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "url", "pid", "healthy", "log", "reused"],
      "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "pid": { "type": ["integer", "null"] }, "healthy": { "type": "boolean" }, "log": { "type": "string" }, "reused": { "type": "boolean" } }
    } },
    "accounts": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "login_hint", "verified_identity"],
      "properties": {
        "role": { "type": "string" }, "login_hint": { "type": "string" },
        "verified_identity": { "type": "object", "additionalProperties": false, "required": ["user_id", "workspace"], "properties": { "user_id": { "type": "string", "minLength": 1 }, "workspace": { "type": "string", "minLength": 1 } } }
      }
    } },
    "contracts": { "type": "object", "additionalProperties": { "type": "string" } },
    "unmet": { "type": "array", "items": { "type": "string" } }
  }
}
